{
  "name": "@boat/run",
  "version": "0.0.1",
  "private": true,
  "description": "boat's one-shot bundle over dsh-base: answer one task, optionally composed from an agent preset, and exit",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@boat/a2ui": "workspace:*",
    "@boat/history-import": "workspace:*",
    "@boat/skill-router": "workspace:*",
    "@boat/tool-policy": "workspace:*",
    "@deepseek-ai/dsh-agent-presets": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-brand": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-cmdline": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-code-runtime-worker-thread": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-util-values": "0.1.5-alpha.2",
    "@deepseek-ai/schemastery": "*",
    "commander": "^15.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/cordis-plugin-loader": "1.0.3",
    "@deepseek-ai/dsh-agent": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-agent-default-model": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.5-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/cordis-plugin-loader": "1.0.3",
    "@deepseek-ai/dsh-agent": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-agent-default-model": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.5-alpha.2"
  }
}
