{
  "name": "@boat/tool-policy",
  "version": "0.0.1",
  "private": true,
  "description": "boat's tool policy over the dsh tool registry: visibility (always/auto + activation), confirmation, and tool-result state deltas folded into the boatState projection",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./preset": {
      "types": "./lib/preset.d.ts",
      "default": "./lib/preset.js"
    }
  },
  "files": ["lib"],
  "dependencies": {
    "@boat/contracts": "workspace:*",
    "@deepseek-ai/dsh-scope": "0.1.5-alpha.2",
    "@deepseek-ai/schemastery": "*",
    "zod": "*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-session-projection": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.5-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-invariants": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-session-projection": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.5-alpha.2"
  }
}
