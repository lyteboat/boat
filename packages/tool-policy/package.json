{
  "name": "@boat/tool-policy",
  "version": "0.0.1",
  "private": true,
  "description": "boat's tool policy over the dsh tool registry: visibility (always/auto + activation), confirmation, and tool-result state deltas folded into the boatState projection",
  "type": "module",
  "exports": {
    ".": {
      "@boat/source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./preset": {
      "@boat/source": "./src/preset.ts",
      "types": "./lib/preset.d.ts",
      "default": "./lib/preset.js"
    }
  },
  "files": ["lib"],
  "dependencies": {
    "@boat/contracts": "workspace:*",
    "@deepseek-ai/dsh-scope": "catalog:dsh",
    "@deepseek-ai/schemastery": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:cordis",
    "@deepseek-ai/dsh-agent": "catalog:dsh",
    "@deepseek-ai/dsh-session": "catalog:dsh",
    "@deepseek-ai/dsh-session-projection": "catalog:dsh",
    "@deepseek-ai/dsh-system-prompt": "catalog:dsh",
    "@deepseek-ai/dsh-tools": "catalog:dsh"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:cordis",
    "@deepseek-ai/dsh-agent": "catalog:dsh",
    "@deepseek-ai/dsh-invariants": "catalog:dsh",
    "@deepseek-ai/dsh-llm": "catalog:dsh",
    "@deepseek-ai/dsh-session": "catalog:dsh",
    "@deepseek-ai/dsh-session-projection": "catalog:dsh",
    "@deepseek-ai/dsh-system-prompt": "catalog:dsh",
    "@deepseek-ai/dsh-tools": "catalog:dsh"
  }
}
