{
  "name": "@boat/a2ui",
  "version": "0.0.1",
  "private": true,
  "description": "boat's A2UI template engine (a port of ark's template mode: manifest resolution, transforms DSL, walker, contract validation) and the render_a2ui tool that folds rendered cards into the boatCards projection",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./preset": {
      "types": "./lib/preset.d.ts",
      "default": "./lib/preset.js"
    },
    "./engine": {
      "types": "./lib/engine.d.ts",
      "default": "./lib/engine.js"
    }
  },
  "files": ["lib"],
  "dependencies": {
    "@boat/contracts": "workspace:*",
    "@boat/tool-policy": "workspace:*",
    "@deepseek-ai/dsh-scope": "0.1.5-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "yaml": "^2.4.2",
    "zod": "*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-session-projection": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.5-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-invariants": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-session-projection": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.5-alpha.2"
  }
}
