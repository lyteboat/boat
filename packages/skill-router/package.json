{
  "name": "@boat/skill-router",
  "version": "0.0.1",
  "private": true,
  "description": "boat's skill router over the dsh skill registry: full / dynamic load modes, LLM routing per user input (ark's LLMSkillRouter), the boatActiveSkill projection, and required-tool activation through @boat/tool-policy",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./preset": {
      "types": "./lib/preset.d.ts",
      "default": "./lib/preset.js"
    }
  },
  "files": ["lib"],
  "dependencies": {
    "@boat/contracts": "workspace:*",
    "@boat/tool-policy": "workspace:*",
    "@deepseek-ai/dsh-scope": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-skill": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-timeout": "0.1.5-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "zod": "*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-session-projection": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.5-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-invariants": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-session-projection": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.5-alpha.2"
  }
}
