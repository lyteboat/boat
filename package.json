{
  "name": "boat-root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json",
    "lint": "oxlint .",
    "test": "pnpm run build && vitest run",
    "test:unit": "vitest run --exclude '**/*.e2e.ts'",
    "check": "pnpm run lint && pnpm run test",
    "smoke:equivalence": "pnpm run build && vitest run apps/cli/tests/driver-equivalence.e2e.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "oxlint": "1.76.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
