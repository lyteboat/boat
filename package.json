{
  "name": "boat-root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json",
    "lint": "oxlint . && knip --include unlisted,unresolved --no-progress && node --import tsx scripts/check-layers.ts",
    "test": "pnpm run build && vitest run",
    "test:unit": "vitest run --exclude '**/*.e2e.ts' --exclude '**/*.composite.ts'",
    "check": "pnpm run lint && pnpm run test",
    "smoke:equivalence": "pnpm run build && vitest run boat/apps/cli/tests/driver-equivalence.e2e.ts",
    "dist:snapshot": "node --import tsx scripts/dist/snapshot.ts",
    "dist:import": "node --import tsx scripts/dist/import-upstream.ts",
    "dist:delta": "node --import tsx scripts/dist/delta-report.ts",
    "dist:overlay": "node --import tsx scripts/dist/overlay.ts",
    "contract:check": "node --import tsx scripts/dist/contract-check.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "knip": "^5.88.1",
    "oxlint": "1.76.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "yaml": "^2.4.2"
  }
}
