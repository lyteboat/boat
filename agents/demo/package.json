{
  "name": "@boat/agent-demo",
  "version": "0.0.1",
  "private": true,
  "description": "boat's demo agent preset: a persona, two routed skills, an asset tool that fills the session state and renders the asset card, a diagnosis tool, and an intake gate",
  "type": "module",
  "exports": {
    "./assets": {
      "@boat/source": "./src/assets.ts",
      "types": "./lib/assets.d.ts",
      "default": "./lib/assets.js"
    }
  },
  "files": ["lib", "preset.yml", "agent.cordis.yml", "skills", "a2ui", "fixtures"],
  "dependencies": {
    "@boat/contracts": "workspace:*",
    "@deepseek-ai/dsh-skill-filesystem": "catalog:dsh",
    "@deepseek-ai/dsh-tools": "catalog:dsh"
  },
  "peerDependencies": {
    "@boat/a2ui": "workspace:*",
    "@boat/tool-policy": "workspace:*",
    "@deepseek-ai/cordis": "catalog:cordis",
    "@deepseek-ai/dsh-agent": "catalog:dsh",
    "@deepseek-ai/dsh-session-projection": "catalog:dsh"
  },
  "devDependencies": {
    "@boat/a2ui": "workspace:*",
    "@boat/tool-policy": "workspace:*",
    "@deepseek-ai/cordis": "catalog:cordis",
    "@deepseek-ai/dsh-agent": "catalog:dsh",
    "@deepseek-ai/dsh-session-projection": "catalog:dsh"
  }
}
