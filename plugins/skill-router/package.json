{
  "name": "@boat/skill-router",
  "version": "0.0.1",
  "private": true,
  "description": "boat's skill router over the dsh skill registry: full / dynamic load modes, LLM routing per user input (ark's LLMSkillRouter), the boatActiveSkill projection, and required-tool activation through @boat/tool-policy",
  "type": "module",
  "exports": {
    ".": {
      "@boat/source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./agent": {
      "@boat/source": "./src/agent.ts",
      "types": "./lib/agent.d.ts",
      "default": "./lib/agent.js"
    }
  },
  "files": ["lib"],
  "dependencies": {
    "@boat/contracts": "workspace:*",
    "@boat/tool-policy": "workspace:*",
    "@deepseek-ai/dsh-scope": "catalog:dsh",
    "@deepseek-ai/dsh-skill": "catalog:dsh",
    "@deepseek-ai/dsh-timeout": "catalog:dsh",
    "@deepseek-ai/schemastery": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:cordis",
    "@deepseek-ai/dsh-agent": "catalog:dsh",
    "@deepseek-ai/dsh-llm": "catalog:dsh",
    "@deepseek-ai/dsh-session": "catalog:dsh",
    "@deepseek-ai/dsh-session-projection": "catalog:dsh",
    "@deepseek-ai/dsh-system-prompt": "catalog:dsh",
    "@deepseek-ai/dsh-tools": "catalog:dsh"
  },
  "devDependencies": {
    "@boat/agentic-loop": "workspace:*",
    "@boat/testing": "workspace:*",
    "@deepseek-ai/cordis": "catalog:cordis",
    "@deepseek-ai/dsh-agent": "catalog:dsh",
    "@deepseek-ai/dsh-invariants": "catalog:dsh",
    "@deepseek-ai/dsh-llm": "catalog:dsh",
    "@deepseek-ai/dsh-session": "catalog:dsh",
    "@deepseek-ai/dsh-session-projection": "catalog:dsh",
    "@deepseek-ai/dsh-system-prompt": "catalog:dsh",
    "@deepseek-ai/dsh-tools": "catalog:dsh"
  }
}
