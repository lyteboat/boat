// knip runs in `pnpm run lint` with --include unlisted,unresolved: every import a package
// makes (src and tests) must resolve through a dependency that package declares. Unused
// dependencies are not checked: lyteboat/apps/cli declares the dsh installation closure the
// launcher resolves rows from, which no source file imports.
{
  "$schema": "https://unpkg.com/knip@5/schema-jsonc.json",
  // The kernel's manifests are upstream's (as npm publishes them) and its tests import
  // through upstream's repository-wide facade; lyteboat does not lint either.
  "ignoreWorkspaces": ["dsh/**"],
  "ignore": ["dsh/**"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts", "scripts/dist/*.ts", "compatibility/tests/*/*.ts"],
      "project": ["scripts/**/*.ts", "compatibility/**/*.ts"]
    },
    "lyteboat/apps/*": {
      "entry": ["tests/**/*.{spec,composite,e2e}.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "lyteboat/bundles/*": {
      "entry": ["tests/**/*.{spec,composite,e2e}.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    // Data only: package.json and cordis.patch.yml.
    "lyteboat/bundles/host": {
      "entry": [],
      "project": []
    },
    "lyteboat/plugins/*": {
      "entry": ["tests/**/*.{spec,composite,e2e}.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "lyteboat/core/*": {
      "entry": ["tests/**/*.{spec,composite,e2e}.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "lyteboat/agents/*": {
      "entry": ["src/*.ts", "tests/**/*.{spec,composite}.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "lyteboat/tooling/*": {
      "project": ["src/**/*.ts"]
    }
  }
}
