{
  "event": "beginRendering",
  "version": "1.0.0",
  "surfaceId": "panoramic-asset-query",
  "rootComponentId": "root-container",
  "showType": "card",
  "hideVoteRecorder": true,
  "components": [
    {
      "id": "root-container",
      "component": {
        "Column": {
          "width": 100,
          "alignment": "left",
          "distribution": "start",
          "gap": 32,
          "children": {
            "explicitList": ["main-card"]
          }
        }
      }
    },
    {
      "id": "main-card",
      "component": {
        "Column": {
          "width": 100,
          "padding": 32,
          "backgroundColor": "#ffffff",
          "borderRadius": "middle",
          "shadow": true,
          "gap": 16,
          "children": {
            "explicitList": [
              "asset-summary",
              "asset-progress",
              "asset-list",
              "insurance-row",
              "disclaimer",
              "auth-btn",
              "diag-btn",
              "auth-tip"
            ]
          }
        }
      }
    },
    {
      "id": "asset-summary",
      "component": {
        "Column": {
          "width": 100,
          "alignment": "left",
          "distribution": "start",
          "gap": 6,
          "marginBottom": 16,
          "children": {
            "explicitList": ["asset-label", "asset-amount"]
          }
        }
      }
    },
    {
      "id": "asset-label",
      "component": {
        "Text": {
          "text": {"path": "summary_label"},
          "fontSize": "14px",
          "color": "rgba(0, 0, 0, 0.6)"
        }
      }
    },
    {
      "id": "asset-amount",
      "component": {
        "Text": {
          "text": {"path": "total_display"},
          "fontSize": "24px",
          "fontFamily": "PingFang SC",
          "color": "#000000",
          "fontWeight": 600
        }
      }
    },
    {
      "id": "asset-progress",
      "component": {
        "AssetProportionProgress": {
          "assetsList": {"path": "assets_list"}
        }
      }
    },
    {
      "id": "asset-list",
      "component": {
        "AssetListCard": {
          "assetsList": {"path": "assets_list"}
        }
      }
    },
    {
      "id": "insurance-row",
      "component": {
        "Row": {
          "width": 100,
          "alignment": "middle",
          "distribution": "spaceBetween",
          "children": {
            "explicitList": ["insurance-label", "insurance-action"]
          }
        }
      }
    },
    {
      "id": "insurance-label",
      "component": {
        "Text": {
          "text": {"literalString": "保险保障"},
          "fontSize": "14px",
          "color": "#000000",
          "fontWeight": 400
        }
      }
    },
    {
      "id": "insurance-action",
      "component": {
        "Row": {
          "alignment": "middle",
          "distribution": "end",
          "gap": 4,
          "children": {
            "explicitList": [
              "insurance-action-text-unauth",
              "insurance-action-text-auth",
              "insurance-action-arrow"
            ]
          }
        }
      }
    },
    {
      "id": "insurance-action-text-unauth",
      "component": {
        "Button": {
          "hide": {"path": "insurance_unauth_hide"},
          "text": {"literalString": "授权查看"},
          "backgroundColor": "transparent",
          "fontSize": "14px",
          "color": "rgba(0, 0, 0, 0.4)",
          "action": [
            {
              "name": "openLink",
              "args": {"url": {"path": "auth_link"}}
            },
            {
              "name": "callLocalTools",
              "surfaceId": "{{surfaceId}}",
              "args": {
                "toolName": "authAndRefresh",
                "toolArgs": {
                  "query": "{{queryMsg}}",
                  "isQueryHide": true,
                  "ui_event": {
                    "name": "a2ui_refresh",
                    "location": "assets_overview",
                    "data": {
                      "surface_id": "{{_localCommonParams.surfaceId}}",
                      "history_id": "{{_localCommonParams.historyId}}"
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },
    {
      "id": "insurance-action-text-auth",
      "component": {
        "Button": {
          "hide": {"path": "insurance_auth_hide"},
          "text": {"path": "insurance_policy_text"},
          "fontSize": "14px",
          "fontWeight": 500,
          "backgroundColor": "transparent",
          "color": "#000000",
          "action": [
            {
              "name": "openLink",
              "args": {"url": {"path": "insurance_sub_page_link"}}
            }
          ]
        }
      }
    },
    {
      "id": "insurance-action-arrow",
      "component": {
        "Text": {
          "text": {"literalString": ">"},
          "fontSize": "14px",
          "color": "rgba(0, 0, 0, 0.4)"
        }
      }
    },
    {
      "id": "disclaimer",
      "component": {
        "Text": {
          "text": {"literalString": "数据基于你已授权账户聚合，未授权账户不计入，本图仅供参考"},
          "fontSize": "12px",
          "color": "rgba(0, 0, 0, 0.4)",
          "lineHeight": "18px"
        }
      }
    },
    {
      "id": "auth-btn",
      "component": {
        "Button": {
          "text": {"literalString": "去授权，查看更全资产"},
          "hide": {"path": "auth_btn_hide"},
          "type": "primary",
          "color": "#ffffff",
          "backgroundColor": "#FA5900",
          "fontSize": "16px",
          "fontWeight": 500,
          "height": 48,
          "borderRadius": 24,
          "block": true,
          "action": [
            {
              "name": "openLink",
              "args": {"url": {"path": "auth_link"}}
            },
            {
              "name": "callLocalTools",
              "surfaceId": "{{surfaceId}}",
              "args": {
                "toolName": "authAndRefresh",
                "toolArgs": {
                  "query": "{{queryMsg}}",
                  "isQueryHide": true,
                  "ui_event": {
                    "name": "a2ui_refresh",
                    "location": "assets_overview",
                    "data": {
                      "surface_id": "{{_localCommonParams.surfaceId}}",
                      "history_id": "{{_localCommonParams.historyId}}"
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },
    {
      "id": "diag-btn",
      "component": {
        "Button": {
          "text": {"literalString": "诊断一下，我的钱放对了吗"},
          "hide": {"path": "diag_btn_hide"},
          "type": "primary",
          "color": "#ffffff",
          "backgroundColor": "#FA5900",
          "fontSize": "16px",
          "fontWeight": 500,
          "height": 48,
          "borderRadius": 24,
          "block": true,
          "action": {
            "name": "query",
            "args": {"queryMsg": "诊断一下，我的钱放对了吗"}
          }
        }
      }
    },
    {
      "id": "auth-tip",
      "component": {
        "Button": {
          "text": {"path": "auth_tip_text"},
          "width": 100,
          "height": "18px",
          "hide": {"path": "auth_tip_hide"},
          "size": "auto",
          "backgroundColor": "transparent",
          "fontSize": "12px",
          "color": "#4584BF",
          "textAlign": "center",
          "lineHeight": "20px",
          "action": [
            {
              "name": "openLink",
              "args": {"url": {"path": "auth_link"}}
            },
            {
              "name": "callLocalTools",
              "surfaceId": "{{surfaceId}}",
              "args": {
                "toolName": "authAndRefresh",
                "toolArgs": {
                  "query": "{{queryMsg}}",
                  "isQueryHide": true,
                  "ui_event": {
                    "name": "a2ui_refresh",
                    "location": "assets_overview",
                    "data": {
                      "surface_id": "{{_localCommonParams.surfaceId}}",
                      "history_id": "{{_localCommonParams.historyId}}"
                    }
                  }
                }
              }
            }
          ]
        }
      }
    }
  ]
}
