{
  "name": "@boat/host",
  "version": "0.0.1",
  "private": true,
  "description": "boat's host bundle over dsh-base: boat's host services (distro marker, tool policy, skill router, a2ui, history import) for every profile that lists it",
  "type": "module",
  "exports": {
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["cordis.patch.yml"],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@boat/a2ui": "workspace:*",
    "@boat/distro": "workspace:*",
    "@boat/history-import": "workspace:*",
    "@boat/skill-router": "workspace:*",
    "@boat/tool-policy": "workspace:*"
  }
}
