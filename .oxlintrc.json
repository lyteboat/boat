{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": [
    "**/lib/**",
    "**/node_modules/**",
    "**/*.js",
    "**/*.cjs",
    "**/*.config.ts"
  ],
  "rules": {
    "no-var": "error",
    "prefer-const": "error",
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error"
  },
  "overrides": [
    {
      "files": [
        "**/tests/**/*.ts"
      ],
      "rules": {
        "typescript/no-non-null-assertion": "off"
      }
    },
    {
      "files": [
        "packages/agentic-loop/**/*.ts",
        "tooling/dsh-agent-loop-testkit-fork/**/*.ts"
      ],
      "rules": {
        "no-shadow": "off",
        "no-underscore-dangle": "off",
        "preserve-caught-error": "off"
      }
    }
  ]
}
