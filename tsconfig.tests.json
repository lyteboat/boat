{
  "extends": "./boat/tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "rootDir": "."
  },
  "include": [
    "boat/apps/*/tests/**/*.ts",
    "boat/apps/*/src/**/*.ts",
    "boat/bundles/*/tests/**/*.ts",
    "boat/bundles/*/src/**/*.ts",
    "boat/plugins/*/tests/**/*.ts",
    "boat/plugins/*/src/**/*.ts",
    "boat/core/*/tests/**/*.ts",
    "boat/core/*/src/**/*.ts",
    "boat/agents/*/tests/**/*.ts",
    "boat/agents/*/src/**/*.ts",
    "boat/tooling/*/tests/**/*.ts",
    "boat/tooling/*/src/**/*.ts",
    "scripts/**/*.ts",
    "conformance/**/*.ts"
  ],
  // Upstream code carried by the G2 harness (it reads cordis const enums, which
  // isolatedModules rejects); upstream type-checks it, boat runs it.
  "exclude": [
    "conformance/upstream-tests/test-invariants.ts",
    "conformance/upstream-tests/shims/*.ts"
  ]
}
