{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "rootDir": "."
  },
  "include": [
    "apps/*/tests/**/*.ts",
    "apps/*/src/**/*.ts",
    "bundles/*/tests/**/*.ts",
    "bundles/*/src/**/*.ts",
    "plugins/*/tests/**/*.ts",
    "plugins/*/src/**/*.ts",
    "core/*/tests/**/*.ts",
    "core/*/src/**/*.ts",
    "agents/*/tests/**/*.ts",
    "agents/*/src/**/*.ts",
    "tooling/*/tests/**/*.ts",
    "tooling/*/src/**/*.ts",
    "scripts/**/*.ts"
  ]
}
