{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "rootDir": "."
  },
  "include": [
    "apps/*/tests/**/*.ts",
    "packages/*/tests/**/*.ts",
    "scripts/**/*.ts",
    "apps/*/src/**/*.ts",
    "packages/*/src/**/*.ts"
  ]
}
