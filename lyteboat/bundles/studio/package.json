{
  "name": "@lyteboat/studio",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "description": "lyteboat's Studio bundle over dsh-base and dsh-web-app: dsh web with lyteboat's pages, offering every agent of the --agents directories and reloading them when they change",
  "type": "module",
  "exports": {
    ".": {
      "@lyteboat/source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "@lyteboat/source": "./src/startup.ts",
      "types": "./lib/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@lyteboat/agent-catalog": "workspace:*",
    "@lyteboat/studio-pages": "workspace:*",
    "@deepseek-ai/dsh-cmdline": "catalog:dsh",
    "commander": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:cordis",
    "@deepseek-ai/cordis-plugin-loader": "catalog:cordis"
  },
  "devDependencies": {
    "@lyteboat/host": "workspace:*",
    "@lyteboat/testing": "workspace:*",
    "@deepseek-ai/cordis": "catalog:cordis",
    "@deepseek-ai/cordis-plugin-loader": "catalog:cordis"
  }
}
