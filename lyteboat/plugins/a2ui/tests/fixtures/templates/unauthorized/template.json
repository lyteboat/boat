{
  "event": "beginRendering",
  "version": "1.0.0",
  "surfaceId": "asset-no-auth-card",
  "rootComponentId": "root-container",
  "showType": "card",
  "components": [
    {
      "id": "root-container",
      "component": {
        "Column": {
          "width": 100,
          "borderRadius": "middle",
          "gap": 16,
          "children": {
            "explicitList": ["auth-text", "auth-btn-row"]
          }
        }
      }
    },
    {
      "id": "auth-text",
      "component": {
        "Text": {
          "text": {
            "literalString": "暂未获取到可用于分析的资产。请点击下方按钮完成账户授权，授权后即可查看您的资产分布。"
          },
          "fontSize": "16px",
          "lineHeight": "24px",
          "color": "#1A1A1A",
          "textAlign": "left",
          "width": 100,
          "marginBottom": 0
        }
      }
    },
    {
      "id": "auth-btn-row",
      "component": {
        "Row": {
          "width": 100,
          "alignment": "middle",
          "distribution": "end",
          "children": {
            "explicitList": ["auth-btn"]
          }
        }
      }
    },
    {
      "id": "auth-btn",
      "component": {
        "Button": {
          "size": "auto",
          "text": {
            "literalString": "去授权"
          },
          "type": "custom",
          "backgroundColor": "transparent",
          "width": "66px",
          "height": "33px",
          "borderRadius": "16px",
          "fontSize": "14px",
          "color": "#FA5900",
          "border": "1px solid #FA5900",
          "action": [
            {
              "name": "openLink",
              "args": {
                "url": {"path": "auth_link"}
              }
            },
            {
              "name": "callLocalTools",
              "surfaceId": "{{surfaceId}}",
              "args": {
                "toolName": "authAndRefresh",
                "toolArgs": {
                  "query": "{{queryMsg}}"
                }
              }
            }
          ]
        }
      }
    }
  ]
}
